---
import '../styles/global.css'

export interface Props {
  title?: string
  description?: string
}

const {
  title = 'OVH DynDNS Client — Self-hosted DynDNS for OVH domains',
  description = 'Point your OVH domains to a dynamic IP and forget about it. One Docker container, encrypted credentials, no external dependencies.',
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://ovh-dyndns.cibran.es').toString()
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="/icons/pwa-512x512.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "OVH DynDNS Client",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux, Docker",
      "description": "Self-hosted dynamic DNS client for OVH domains. Automatically updates DynHost DNS records when your public IP changes. One Docker container, REST API with JWT auth, encrypted credentials, no external dependencies.",
      "url": "https://ovh-dyndns.cibran.es/",
      "downloadUrl": "https://hub.docker.com/r/cibrandocampo/ovh-dyndns-client",
      "codeRepository": "https://github.com/cibrandocampo/ovh-dyndns-client",
      "license": "https://github.com/cibrandocampo/ovh-dyndns-client/blob/main/LICENSE",
      "programmingLanguage": "Python",
      "softwareVersion": "5",
      "keywords": "OVH, DynDNS, dynamic DNS, DynHost, self-hosted, Docker, FastAPI",
      "author": {
        "@type": "Person",
        "name": "Cibrán Docampo Piñeiro"
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />
  </head>
  <body class="min-h-screen bg-gradient-to-br from-ovh-950 via-slate-950 to-ovh-900 text-slate-100 antialiased">
    <slot />
  </body>
</html>
